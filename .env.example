# Sentinela - Configuração de Ambiente

# Aplicação
APP_NAME=Sentinela
APP_VERSION=1.0.0
DEBUG=True
LOG_LEVEL=INFO

# Servidor
HOST=0.0.0.0
PORT=8000

# APIs Externas
# ------------

# DataJud/CNJ - OBRIGATÓRIA
# Solicite sua chave em: https://www.cnj.jus.br/sistemas/datajud/api-publica/
DATAJUD_API_KEY=sua_chave_api_aqui

# Querido Diário - NÃO REQUER AUTENTICAÇÃO
QUERIDO_DIARIO_BASE_URL=https://api.queridodiario.ok.org.br

# TCU - NÃO REQUER AUTENTICAÇÃO
TCU_BASE_URL=https://dados-abertos.apps.tcu.gov.br/api

# DOU - Dados Abertos (atualização mensal)
DOU_DADOS_ABERTOS_URL=http://dados.gov.br/dataset/diario-oficial-da-uniao

# Timeouts (em segundos)
HTTP_TIMEOUT=30
AGGREGATOR_TIMEOUT=120

# Cache Redis (opcional)
REDIS_ENABLED=False
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TTL=86400  # 24 horas em segundos

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60

# Paginação
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# Busca
MAX_SOURCES_PARALLEL=5
RETRY_ATTEMPTS=3
RETRY_BACKOFF_FACTOR=2

# CORS
CORS_ENABLED=True
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# Logging
LOG_FORMAT=json
LOG_FILE=logs/sentinela.log
LOG_ROTATION=1 day
LOG_RETENTION=30 days

# Elasticsearch (opcional - para indexação avançada)
ELASTICSEARCH_ENABLED=False
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_INDEX=sentinela
